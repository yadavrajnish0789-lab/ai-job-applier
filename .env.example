# ==============================================================================
# JobPilot AI - Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key
# Used for Job Description extraction, ATS Resume Tailoring, and AI Form Field Mapping.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cloud Headless Browser WebSocket CDP Endpoint (Required for Vercel Serverless)
# Vercel serverless functions cannot bundle heavy local Chrome binaries.
# Connect over WebSocket CDP using free tiers from:
# - Browserless.io: wss://chrome.browserless.io?token=YOUR_API_TOKEN
# - Browserbase.com: wss://connect.browserbase.com?apiKey=YOUR_API_KEY
# 
# NOTE: When running locally, if BROWSER_WS_ENDPOINT is left blank,
# the app will automatically fall back to your local Google Chrome / Edge installation.
BROWSER_WS_ENDPOINT=

# Optional: Port configuration
PORT=3000
